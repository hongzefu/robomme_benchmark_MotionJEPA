   "N": []
  },
  "PickHighlight": {
   "L": ["layout.button_xy", "objects.color_rgba.*", "layout.cubes.*"],
   "G": ["objects.n_cubes", "objects.highlight_count", "objects.highlight_ids"],
   "N": []
  },
  "PatternLock": {
   "L": ["actions.path_nodes[:n]"],
   "G": [],
   "N": []
  },
  "RouteStick": {
   "L": ["layout.rotation_deg", "layout.obstacle_rgb.*", "actions.nodes[:n]", "actions.directions.*"],
   "G": ["objects.L"],
   "N": []
  }
 }
