   "G": ["objects.num_repeats"],
   "N": []
  },
  "BinFill": {
   "L": ["layout.dynamic", "layout.button_xy", "layout.board.offsets", "objects.color_pool", "objects.put_in_color", "objects.spawn_numbers", "objects.spawn_order", "layout.slots.*", "objects.slot_assignment", "initializations.*.color_order"],
   "G": [],
   "N": ["objects.target_numbers"]
  },
  "VideoUnmaskSwap": {
   "L": ["layout.type_choice", "layout.bins.*", "objects.color_order", "objects.selected", "objects.target_choice", "objects.swap_initiator_indices", "objects.swap_initiator_third", "objects.distractors.color_order"],
   "G": ["objects.n_swaps", "objects.n_picks", "objects.swap_plan_seed", "actions.swap_pairs.*", "objects.distractors.cube_count", "objects.distractors.cube_bins", "objects.distractors.label_perm", "objects.distractors.swap_plan_seed"],
   "N": ["objects.distractors.bins.*"]
  },
  "ButtonUnmaskSwap": {
   "L": ["layout.type_choice", "layout.bins.*", "objects.color_order", "objects.selected", "objects.target_choice", "objects.swap_initiator_indices", "objects.swap_initiator_third", "objects.distractors.color_order"],
   "G": ["objects.n_swaps", "objects.n_picks", "objects.swap_plan_seed", "actions.swap_pairs.*", "objects.distractors.cube_count", "objects.distractors.cube_bins", "objects.distractors.label_perm", "objects.distractors.swap_plan_seed"],
   "N": ["objects.distractors.bins.*"]
  },
  "VideoUnmask": {
   "L": ["layout.bins.*", "objects.color_order", "objects.distractors.bins.*", "objects.distractors.color_order"],
   "G": ["objects.distractors.cube_count", "objects.distractors.cube_bins"],
   "N": []
  },
  "ButtonUnmask": {
   "L": ["layout.button_xy", "layout.bins.*", "objects.color_order", "objects.distractors.bins.*", "objects.distractors.color_order"],
   "G": ["objects.distractors.cube_count", "objects.distractors.cube_bins", "actions.sampling_trace.constructor_draw"],
   "N": []
  },
  "VideoRepick": {
   "L": ["objects.color_rgb", "layout.cubes.*.xy_yaw"],
   "G": ["objects.num_repeats", "objects.n_swaps", "objects.target", "objects.swap_initiators_remaining", "objects.swap_plan_seed", "actions.swap_pairs.*"],
   "N": []
  },
  "VideoPlaceButton": {
   "L": ["layout.goal_xy", "layout.button_xy", "objects.color_order", "layout.cubes.*", "layout.targets.*"],
   "G": ["objects.demo_ids", "objects.swap_pair_ids", "objects.task_flag", "objects.answer_demo_index", "objects.extra_place_owner_ids", "objects.extra_place_target_ids.*.*"],
   "N": []
