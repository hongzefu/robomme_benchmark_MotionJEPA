{
 "schema": "layout-whitelist/1",
 "note": "V7 共用布局白名单（0928 方案第二部分 §1.3、R10）：L＝注入母值（[:n] 为列表按本档抽到的长度取母值前缀），G＝本档现场取值，N＝由母值嵌套派生（D-15）。模式按段匹配，* 恰好匹配一段。StopCube／InsertPeg／MoveCube 只有 xhard4，不派生。Swap 两任务的外环容器归 N（D-19：取母布局外环按角度序的一段可行连续弧）。",
 "tasks": {
  "PickXtimes": {
   "L": ["layout.button_xy", "objects.color_order", "objects.target_color_idx", "layout.goal_xy", "layout.cubes.*", "objects.target_cube_idx", "layout.distractors.*"],
   "G": ["objects.num_repeats"],
   "N": []
  },
  "SwingXtimes": {
